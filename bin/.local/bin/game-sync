#!/usr/bin/env bash
# game-sync — Automated Two-Way Sync between PC Emulators and Delta iOS (via Dropbox)

GAMES_DIR="$HOME/games"
GBA_DIR="$GAMES_DIR/gba"
NDS_DIR="$GAMES_DIR/nds"
DROPBOX_REMOTE="dropbox"
DELTA_DIR="Delta Emulator"

# 1. Local timestamped backup safeguard
backup_local_saves() {
    local save_dir="$1"
    local backup_dir="$save_dir/backups"
    if [[ -d "$save_dir" ]]; then
        mkdir -p "$backup_dir"
        local ts
        ts=$(date +'%Y-%m-%d_%H-%M-%S')
        for sav in "$save_dir"/*.sav; do
            if [[ -f "$sav" ]]; then
                local base
                base=$(basename "$sav")
                cp "$sav" "$backup_dir/${base%.sav}_${ts}.sav" 2>/dev/null
            fi
        done
        # Keep latest 30 backups
        find "$backup_dir" -type f -name "*.sav" 2>/dev/null | sort | head -n -30 | xargs -r rm -f 2>/dev/null
    fi
}

# 2. Pull saves from Delta/Dropbox to PC
pull_saves() {
    if ! rclone listremotes 2>/dev/null | grep -q "^${DROPBOX_REMOTE}:"; then
        return 1
    fi

    backup_local_saves "$GBA_DIR/saves"
    backup_local_saves "$NDS_DIR/roms"
    backup_local_saves "$NDS_DIR/saves"

    python3 - << 'PY'
import subprocess
import hashlib
import json
import os
from pathlib import Path

games_dir = Path(os.path.expanduser("~/games"))
remote = "dropbox:Delta Emulator"

# Scan all ROMs
roms = list(games_dir.glob("gba/roms/*.gba")) + list(games_dir.glob("nds/roms/*.nds"))

updated = False
for rom in roms:
    with open(rom, "rb") as f:
        rom_hash = hashlib.sha1(f.read()).hexdigest()
    
    delta_save_name = f"GameSave-{rom_hash}-gameSave"
    
    # Check if delta save exists on Dropbox
    try:
        check = subprocess.run(
            ["rclone", "lsf", f"{remote}/{delta_save_name}"],
            capture_output=True, text=True, check=True
        )
        if not check.stdout.strip():
            continue
    except Exception:
        continue

    # Determine local save paths
    local_saves = []
    if rom.suffix.lower() == ".gba":
        local_saves.append(games_dir / "gba" / "saves" / f"{rom.stem}.sav")
    elif rom.suffix.lower() == ".nds":
        local_saves.append(rom.parent / f"{rom.stem}.sav")
        local_saves.append(rom.parent / f"{rom.stem}.ml1.sav")
        local_saves.append(games_dir / "nds" / "saves" / f"{rom.stem}.sav")

    # Download from Delta if remote differs
    temp_target = Path("/tmp") / delta_save_name
    subprocess.run(["rclone", "copyto", f"{remote}/{delta_save_name}", str(temp_target)], capture_output=True)
    if temp_target.exists():
        with open(temp_target, "rb") as f:
            new_data = f.read()
            new_hash = hashlib.sha1(new_data).hexdigest()

        for l_sav in local_saves:
            curr_hash = ""
            if l_sav.exists():
                with open(l_sav, "rb") as f:
                    curr_hash = hashlib.sha1(f.read()).hexdigest()
            if curr_hash != new_hash:
                l_sav.parent.mkdir(parents=True, exist_ok=True)
                with open(l_sav, "wb") as f:
                    f.write(new_data)
                updated = True
        temp_target.unlink(missing_ok=True)

if updated:
    subprocess.run(["notify-send", "-a", "Game Sync", "-i", "folder-download", "Delta Sync", "Updated game saves from iPhone!"])
PY
}

# 3. Push local PC saves to Delta/Dropbox
push_saves() {
    if ! rclone listremotes 2>/dev/null | grep -q "^${DROPBOX_REMOTE}:"; then
        return 1
    fi

    backup_local_saves "$GBA_DIR/saves"
    backup_local_saves "$NDS_DIR/roms"
    backup_local_saves "$NDS_DIR/saves"

    python3 - << 'PY'
import subprocess
import hashlib
import json
import os
import time
from pathlib import Path

games_dir = Path(os.path.expanduser("~/games"))
remote = "dropbox:Delta Emulator"
transfer_remote = "dropbox:PC_Saves_Transfer"

roms = list(games_dir.glob("gba/roms/*.gba")) + list(games_dir.glob("nds/roms/*.nds"))
updated = False

for rom in roms:
    with open(rom, "rb") as f:
        rom_hash = hashlib.sha1(f.read()).hexdigest()

    delta_save_name = f"GameSave-{rom_hash}-gameSave"
    delta_meta_name = f"GameSave-{rom_hash}"

    # Find the most recently modified local save file
    possible_saves = []
    if rom.suffix.lower() == ".gba":
        possible_saves.append(games_dir / "gba" / "saves" / f"{rom.stem}.sav")
    elif rom.suffix.lower() == ".nds":
        possible_saves.append(rom.parent / f"{rom.stem}.ml1.sav")
        possible_saves.append(rom.parent / f"{rom.stem}.sav")
        possible_saves.append(games_dir / "nds" / "saves" / f"{rom.stem}.sav")

    valid_saves = [s for s in possible_saves if s.exists()]
    if not valid_saves:
        continue

    latest_save = max(valid_saves, key=lambda s: s.stat().st_mtime)
    with open(latest_save, "rb") as f:
        save_data = f.read()
        save_hash = hashlib.sha1(save_data).hexdigest()

    # Upload directly as Delta's GameSave file
    temp_file = Path("/tmp") / delta_save_name
    with open(temp_file, "wb") as f:
        f.write(save_data)
    
    subprocess.run(["rclone", "copyto", str(temp_file), f"{remote}/{delta_save_name}"], capture_output=True)
    temp_file.unlink(missing_ok=True)

    # Update metadata JSON for Delta Sync
    meta_json = {
        "relationships": {"game": {"identifier": rom_hash, "type": "Game"}},
        "type": "GameSave",
        "identifier": rom_hash,
        "files": [{
            "size": len(save_data),
            "identifier": "gameSave",
            "remoteIdentifier": f"/delta emulator/{delta_save_name.lower()}",
            "versionIdentifier": hex(int(time.time() * 1000))[2:],
            "sha1Hash": save_hash
        }],
        "sha1Hash": save_hash,
        "record": {
            "modifiedDate": time.time() - 978307200, # Apple CoreData timestamp (seconds since 2001)
            "sha1": save_hash
        }
    }
    temp_meta = Path("/tmp") / delta_meta_name
    with open(temp_meta, "w") as f:
        json.dump(meta_json, f, separators=(",", ":"))
    subprocess.run(["rclone", "copyto", str(temp_meta), f"{remote}/{delta_meta_name}"], capture_output=True)
    temp_meta.unlink(missing_ok=True)

    # Also upload to PC_Saves_Transfer for safety
    if rom.suffix.lower() == ".gba":
        subprocess.run(["rclone", "copyto", str(latest_save), f"{transfer_remote}/gba_saves/{latest_save.name}"], capture_output=True)
    else:
        subprocess.run(["rclone", "copyto", str(latest_save), f"{transfer_remote}/nds_saves/{latest_save.name}"], capture_output=True)

    updated = True

if updated:
    subprocess.run(["notify-send", "-a", "Game Sync", "-i", "folder-remote", "Delta Sync", "Saves synced to Dropbox for iPhone!"])
PY
}

case "$1" in
    pull)
        pull_saves
        ;;
    push)
        push_saves
        ;;
    status)
        echo "=== Delta Cloud Saves in Dropbox ==="
        rclone lsl "${DROPBOX_REMOTE}:${DELTA_DIR}" 2>/dev/null
        ;;
    *)
        echo "Usage: game-sync {pull|push|status}"
        exit 1
        ;;
esac
