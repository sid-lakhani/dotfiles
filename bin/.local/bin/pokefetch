#!/usr/bin/env python3
"""Pokéfetch — High-craft, theme-aware Pokémon fetch banner for Caelestia Desktop."""

import json
import os
import random
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
ART_DIR = HOME / ".cache" / "pokeart"
ANIM_DIR = HOME / ".cache" / "pokeanim"
BOX_DIR = ANIM_DIR / ".box"
CACHE_DIR = HOME / ".cache" / "pokepalette"
RANK_PNG = CACHE_DIR / "rank-png.txt"
RANK_GIF = CACHE_DIR / "rank-gif.txt"
POKE_THEME = HOME / ".local" / "bin" / "poke-theme"

