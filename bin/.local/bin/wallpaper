#!/usr/bin/env bash
set -euo pipefail

cd "$HOME"
export CAELESTIA_WALLPAPERS_DIR="${CAELESTIA_WALLPAPERS_DIR:-$HOME/pix/wall}"

stop_engines() {
    pkill -x mpvpaper 2>/dev/null || true
    pkill -f "mpvpaper" 2>/dev/null || true
    local tries=0
    while pgrep -f "mpvpaper" >/dev/null 2>&1 && [[ $tries -lt 20 ]]; do
        sleep 0.05
        tries=$((tries + 1))
    done
    if pgrep -f "mpvpaper" >/dev/null 2>&1; then
        pkill -9 -f "mpvpaper" 2>/dev/null || true
    fi
}

ensure_awww() {
    if ! awww query >/dev/null 2>&1; then
        systemctl --user reset-failed awww-daemon >/dev/null 2>&1 || true
        systemd-run --user --unit=awww-daemon \
            -E WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" \
            -E XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}" \
            /usr/bin/awww-daemon >/dev/null 2>&1 || true
        sleep 0.3
    fi
}

is_caelestia_running() {
    qs list -c caelestia 2>/dev/null | grep -q "^Instance "
}

restart_caelestia_shell() {
    # Find only the instance(s) matching caelestia shell
    local instances
    instances=$(qs list -c caelestia 2>/dev/null | awk '/^Instance / { id=$2; sub(/:$/, "", id); print id }')
    for inst in $instances; do
        qs kill -i "$inst" 2>/dev/null || true
    done

    # Ensure previous instances are gone before relaunching without arbitrary long sleeps
    local tries=0
    while qs list -c caelestia 2>/dev/null | grep -q "^Instance " && [[ $tries -lt 30 ]]; do
        sleep 0.1
        tries=$((tries + 1))
    done

    # In case any stuck process remains with config caelestia, terminate gracefully
    if qs list -c caelestia 2>/dev/null | grep -q "^Instance "; then
        pkill -TERM -f "qs.*-c caelestia" 2>/dev/null || true
        pkill -TERM -f "qs.*caelestia/shell.qml" 2>/dev/null || true
        sleep 0.2
    fi

    # Kill external notification daemons so quickshell claims org.freedesktop.Notifications
    pkill -x mako 2>/dev/null || true

    # Relaunch single user shell instance using caelestia shell -d (enforces -n)
    caelestia shell -d
}

set_wallpaper_mode() {
    local mode="$1" # static | live | disabled
    local state_dir="$HOME/.local/state/caelestia/wallpaper"
    mkdir -p "$state_dir"
    echo "$mode" > "$state_dir/mode.txt"

    # Always treat as live/externally managed so Caelestia leaves the background layer
    # transparent to awww. This prevents Caelestia's QML image loader from covering awww
    # and breaking the circle reveal animation.
    local is_live="true"
    local enabled="true"
    if [[ "$mode" == "disabled" ]]; then
        is_live="false"
        enabled="false"
    fi

    # Update shell.json only if wallpaperEnabled actually changed (prevents quickshell hot-reload)
    python - "$HOME/.config/caelestia/shell.json" "$enabled" << 'PY'
import json
import sys

path, enabled = sys.argv[1], sys.argv[2] == "true"
try:
    with open(path) as f:
        config = json.load(f)
except Exception:
    config = {}
current = config.get("background", {}).get("wallpaperEnabled")
if current != enabled:
    config.setdefault("background", {})["wallpaperEnabled"] = enabled
    with open(path, "w") as f:
        json.dump(config, f, indent=4)
        f.write("\n")
PY

    # Send IPC to quickshell if running
    if is_caelestia_running; then
        if [[ "$enabled" == "true" ]]; then
            qs ipc -c caelestia call wallpaper enable >/dev/null 2>&1 || true
        else
            qs ipc -c caelestia call wallpaper disable >/dev/null 2>&1 || true
        fi
        qs ipc -c caelestia call wallpaper setLive "$is_live" >/dev/null 2>&1 || true
    else
        # Fallback: only launch if not running, using caelestia shell -d (enforces -n)
        caelestia shell -d
    fi
}

set_caelestia_wallpaper() {
    local enabled="$1"
    if [[ "$enabled" == "true" ]]; then
        set_wallpaper_mode static
        sync_terminal_theme
    else
        set_wallpaper_mode disabled
    fi
}

ensure_thumbnail() {
    local vid="$1"
    local dir="$(dirname "$vid")"
    local base="$(basename "$vid")"
    base="${base%.*}"
    local thumb_dir="$dir/.thumbnails"
    local thumb="$thumb_dir/${base}.jpg"
    if [[ ! -f "$thumb" && "$vid" =~ \.(mp4|mkv|webm)$ ]] && command -v ffmpeg >/dev/null 2>&1; then
        mkdir -p "$thumb_dir"
        ffmpeg -y -i "$vid" -vframes 1 -q:v 2 "$thumb" >/dev/null 2>&1 || true
    fi
}

generate_all_thumbnails() {
    local live_dir="${CAELESTIA_WALLPAPERS_DIR:-$HOME/pix/wall}/live"
    [[ -d "$live_dir" ]] || live_dir="${CAELESTIA_WALLPAPERS_DIR:-$HOME/pix/wall}/animated"
    mkdir -p "$live_dir/.thumbnails"
    for vid in "$live_dir"/*.{mp4,mkv,webm}; do
        [[ -f "$vid" ]] || continue
        ensure_thumbnail "$vid"
    done
}

optimize_videos() {
    local live_dir="${CAELESTIA_WALLPAPERS_DIR:-$HOME/pix/wall}/live"
    [[ -d "$live_dir" ]] || live_dir="${CAELESTIA_WALLPAPERS_DIR:-$HOME/pix/wall}/animated"
    mkdir -p "$live_dir"
    echo "Inspecting animated wallpapers for display resolution optimization..."
    for vid in "$live_dir"/*.{mp4,mkv,webm}; do
        [[ -f "$vid" ]] || continue
        local width
        width=$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of default=noprint_wrappers=1:nokey=1 "$vid" 2>/dev/null || echo "")
        if [[ -n "$width" && "$width" -gt 1920 ]]; then
            echo "Downscaling $(basename "$vid") from ${width}px to native 1080p (reduces frame buffer memory by ~75%)..."
            local tmp="${vid%.*}.1080p_temp.mp4"
            ffmpeg -y -i "$vid" -vf "scale=1920:-2:flags=lanczos" -c:v libx264 -crf 20 -preset fast -an "$tmp" >/dev/null 2>&1
            if [[ -f "$tmp" && -s "$tmp" ]]; then
                mv "$tmp" "$vid"
                echo "✓ Optimized $(basename "$vid")"
            else
                rm -f "$tmp"
            fi
        else
            echo "✓ $(basename "$vid") is already optimal (${width:-unknown}px)"
        fi
    done
    generate_all_thumbnails
    echo "Optimization complete! Live wallpapers are now native 1080p with minimal RAM footprint."
}

usage() {
    echo "Usage: wallpaper static <image> | gif <animation.gif> | video <video.mp4> | preview <file> | random | resume | stop | stop-engines | restart-shell | generate-thumbnails | optimize-videos"
}

adapt_scheme_variant() {
    local target="$1"
    [[ -f "$target" ]] || return 0
    extract-palette adapt "$target" >/dev/null 2>&1 || true
}

preview_colors() {
    local target="$1"
    [[ -f "$target" ]] || { echo "{}"; return 1; }
    extract-palette adapt "$target" >/dev/null 2>&1 || true
    python3 - "$target" << 'PY'
from pathlib import Path
from caelestia.utils import wallpaper
from caelestia.utils.scheme import get_scheme
import json
import sys

wall = Path(sys.argv[1]).resolve()
if wall.suffix.lower() == ".gif":
    wall = wallpaper.convert_gif(wall)
elif wall.suffix.lower() in [".mp4", ".mkv", ".webm"]:
    thumb = wall.parent / ".thumbnails" / f"{wall.stem}.jpg"
    if thumb.exists():
        wall = thumb

cache = wallpaper.wallpapers_cache_dir / wallpaper.compute_hash(wall)
scheme = get_scheme()
cols = wallpaper.get_colours_for_image(wallpaper.get_thumb(wall, cache), scheme)

print(json.dumps({
    "name": "dynamic",
    "flavour": scheme.flavour,
    "mode": "dark",
    "variant": scheme.variant,
    "colours": cols,
}))
PY
}

sync_editor_theme() {
    local ext_dir="$HOME/.local/share/caelestia/extensions/soramanew.caelestia-vscode-integration-1.2.0"
    if [[ -d "$ext_dir" ]]; then
        node - "$ext_dir" << 'NODE' >/dev/null 2>&1 &
const fs = require("fs");
const path = require("path");
const extDir = process.argv[1];
const schemePath = path.join(process.env.HOME, ".local/state/caelestia/scheme.json");
if (!fs.existsSync(schemePath) || !fs.existsSync(path.join(extDir, "out/theme.js"))) process.exit(0);
try {
    const theme = require(path.join(extDir, "out/theme")).default;
    const scheme = JSON.parse(fs.readFileSync(schemePath, "utf-8"));
    const colours = Object.fromEntries(Object.entries(scheme.colours).map(([n, c]) => [n, `#${c}`]));
    fs.writeFileSync(path.join(extDir, "themes/caelestia.json"), JSON.stringify(theme(colours)));
} catch (e) {}
NODE
    fi
}

sync_terminal_theme() {
    local wall_img="${1:-}"
    if [[ -z "$wall_img" && -f "$HOME/.local/state/caelestia/wallpaper/path.txt" ]]; then
        wall_img=$(cat "$HOME/.local/state/caelestia/wallpaper/path.txt")
    fi
    if [[ -z "$wall_img" && -f "$HOME/.local/state/caelestia/wallpaper/live_path.txt" ]]; then
        wall_img=$(cat "$HOME/.local/state/caelestia/wallpaper/live_path.txt")
    fi

    if [[ -n "$wall_img" && -f "$wall_img" ]]; then
        extract-palette sync "$wall_img" >/dev/null 2>&1 || true
    fi

    sync_editor_theme
}

set_static() {
    [[ $# -eq 1 && -f "$1" ]] || { usage; exit 1; }
    local img="$1"
    stop_engines
    ensure_awww
    # Tell daemon to start 144 FPS circle grow transition (CLI returns in ~0.15s)
    awww img "$img" --transition-type grow --transition-pos 0.5,0.5 --transition-fps 144 --transition-duration 0.7 >/dev/null 2>&1 || true
    # Async: update theme + caelestia path state after circle completes
    (
        sleep 0.8
        adapt_scheme_variant "$img"
        caelestia wallpaper --no-smart -f "$img" >/dev/null 2>&1 || true
        set_wallpaper_mode static
        sync_terminal_theme "$img"
    ) >/dev/null 2>&1 &
    disown
}

set_gif() {
    [[ $# -eq 1 && -f "$1" ]] || { usage; exit 1; }
    local gif="$1"
    stop_engines
    ensure_awww
    # awww handles animated gifs natively
    awww img "$gif" --transition-type grow --transition-pos 0.5,0.5 --transition-fps 144 --transition-duration 0.7 >/dev/null 2>&1 || true
    (
        sleep 0.8
        adapt_scheme_variant "$gif"
        caelestia wallpaper --no-smart -f "$gif" >/dev/null 2>&1 || true
        echo "$gif" > "$HOME/.local/state/caelestia/wallpaper/live_path.txt"
        set_wallpaper_mode static
        sync_terminal_theme "$gif"
    ) >/dev/null 2>&1 &
    disown
}

set_video() {
    [[ $# -eq 1 && -f "$1" ]] || { usage; exit 1; }
    local vid="$1"
    stop_engines
    ensure_thumbnail "$vid"
    local base="$(basename "$vid")"
    base="${base%.*}"
    local thumb="$(dirname "$vid")/.thumbnails/${base}.jpg"
    ensure_awww

    # 1. Expand frame 0 thumbnail with circle grow (0.5s duration)
    if [[ -f "$thumb" ]]; then
        awww img "$thumb" --transition-type grow --transition-pos 0.5,0.5 --transition-fps 144 --transition-duration 0.5 >/dev/null 2>&1 || true
    fi

    # 2. Launch mpvpaper silently in parallel:
    #    - Disown & detach via setsid with zero terminal I/O (--no-terminal, --msg-level=all=no)
    #    - Spawns at 0.15s: mpv decodes frame 0 while circle is expanding
    #    - By 0.5s circle completes and mpvpaper seamlessly continues playback
    echo "$vid" > "$HOME/.local/state/caelestia/wallpaper/live_path.txt"
    local mpv_opts="no-audio loop --loop-file=inf --hwdec=auto-safe --vd-lavc-threads=2 --demuxer-max-bytes=16MiB --sws-scaler=fast-bilinear --no-terminal --msg-level=all=no"
    sleep 0.15
    setsid mpvpaper -p -o "$mpv_opts" eDP-1 "$vid" </dev/null >/dev/null 2>&1 &

    # 3. Synchronize theme palette and state in the background
    (
        sleep 0.6
        set_wallpaper_mode live
        if [[ -f "$thumb" ]]; then
            adapt_scheme_variant "$thumb"
            caelestia wallpaper --no-smart -f "$thumb" >/dev/null 2>&1 || true
            sync_terminal_theme "$thumb"
        else
            sync_terminal_theme "$vid"
        fi
    ) >/dev/null 2>&1 &
    disown
}

pick_and_set_random() {
    stop_engines
    local wall_base="${CAELESTIA_WALLPAPERS_DIR:-$HOME/pix/wall}"
    local candidates=()

    # Collect exciting wallpapers from images/ and live/
    while IFS= read -r f; do
        [[ -n "$f" ]] && candidates+=("$f")
    done < <(find "$wall_base/images" "$wall_base/live" -maxdepth 2 -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" -o -name "*.mp4" -o -name "*.webm" -o -name "*.mkv" -o -name "*.gif" \) ! -path "*/.*" 2>/dev/null)

    # Fallback to any file in wall_base if images/live are empty
    if [[ ${#candidates[@]} -eq 0 ]]; then
        while IFS= read -r f; do
            [[ -n "$f" ]] && candidates+=("$f")
        done < <(find "$wall_base" -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" -o -name "*.mp4" -o -name "*.webm" -o -name "*.mkv" -o -name "*.gif" \) ! -path "*/.*" 2>/dev/null)
    fi

    if [[ ${#candidates[@]} -gt 0 ]]; then
        local chosen="${candidates[RANDOM % ${#candidates[@]}]}"
        if [[ "$chosen" =~ \.(mp4|mkv|webm)$ ]]; then
            set_video "$chosen"
        elif [[ "$chosen" =~ \.gif$ ]]; then
            set_gif "$chosen"
        else
            set_static "$chosen"
        fi
    else
        caelestia wallpaper --no-smart -r
        set_wallpaper_mode static
        sync_terminal_theme
    fi
}

resume_wallpaper() {
    local mode="static"
    local state_dir="$HOME/.local/state/caelestia/wallpaper"
    [[ -f "$state_dir/mode.txt" ]] && mode=$(cat "$state_dir/mode.txt")
    local live_file="$state_dir/live_path.txt"
    if [[ "$mode" == "live" && -f "$live_file" ]]; then
        local target
        target=$(cat "$live_file")
        if [[ -f "$target" ]]; then
            if [[ "$target" =~ \.gif$ ]]; then
                set_gif "$target"
                return
            else
                set_video "$target"
                return
            fi
        fi
    fi
    local curr="$state_dir/path.txt"
    if [[ -f "$curr" ]]; then
        set_static "$(cat "$curr")"
    else
        pick_and_set_random
    fi
}

case "${1:-}" in
    set)
        shift
        target="${1:-}"
        [[ -f "$target" ]] || { echo "Wallpaper file not found: $target"; exit 1; }
        if [[ "$target" =~ \.(mp4|mkv|webm)$ ]]; then
            set_video "$target"
        elif [[ "$target" =~ \.gif$ ]]; then
            set_gif "$target"
        else
            set_static "$target"
        fi
        ;;
    static)
        shift
        set_static "${1:-}"
        ;;
    preview)
        shift
        preview_colors "${1:-}"
        ;;
    random)
        pick_and_set_random
        ;;
    gif)
        shift
        set_gif "${1:-}"
        ;;
    video)
        shift
        set_video "${1:-}"
        ;;
    resume)
        resume_wallpaper
        ;;
    stop)
        stop_engines
        set_wallpaper_mode disabled
        ;;
    stop-engines)
        stop_engines
        ;;
    restart-shell)
        restart_caelestia_shell
        ;;
    generate-thumbnails)
        generate_all_thumbnails
        ;;
    optimize-videos)
        optimize_videos
        ;;
    *)
        usage
        exit 1
        ;;
esac
