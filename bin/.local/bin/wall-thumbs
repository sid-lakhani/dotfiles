#!/usr/bin/env python3
"""wall-thumbs — generates 900x420 thumbnails for ~/pix/wall/{images,live}"""
import os
import shutil
import subprocess
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor

HOME = Path.home()
WALLS_BASE = Path(os.environ.get("CAELESTIA_WALLPAPERS_DIR", HOME / "pix" / "wall")).resolve()
THUMBS_BASE = HOME / ".cache" / "wallpaper-thumbs"
THUMBS_BASE.mkdir(parents=True, exist_ok=True)

GEOM = "900x420^"


def process_image(img: Path, out: Path):
    if out.exists() and out.stat().st_size > 0 and out.stat().st_mtime >= img.stat().st_mtime:
        return
    tmp = out.parent / f".tmp_{out.name}"
    cmd = [
        "magick", f"{img}[0]" if img.suffix.lower() == ".gif" else str(img),
        "-auto-orient", "-thumbnail", GEOM, "-strip", "-quality", "85", str(tmp)
    ]
    res = subprocess.run(cmd, stderr=subprocess.DEVNULL)
    if res.returncode == 0 and tmp.exists():
        tmp.replace(out)
    elif tmp.exists():
        tmp.unlink(missing_ok=True)


def process_video(vid: Path, out: Path):
    if out.exists() and out.stat().st_size > 0 and out.stat().st_mtime >= vid.stat().st_mtime:
        return
    tmp = out.parent / f".tmp_{out.name}"
    if vid.suffix.lower() == ".gif":
        cmd = [
            "magick", f"{vid}[0]",
            "-auto-orient", "-thumbnail", GEOM, "-strip", "-quality", "85", str(tmp)
        ]
        res = subprocess.run(cmd, stderr=subprocess.DEVNULL)
    else:
        res = subprocess.run([
            "ffmpeg", "-y", "-i", str(vid), "-vframes", "1", "-update", "1",
            "-vf", "scale=900:420:force_original_aspect_ratio=increase,crop=900:420", "-q:v", "2", str(tmp)
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if res.returncode == 0 and tmp.exists():
        tmp.replace(out)
    elif tmp.exists():
        tmp.unlink(missing_ok=True)


def main():
    img_dir = WALLS_BASE / "images"
    live_dir = WALLS_BASE / "live"
    out_img_dir = THUMBS_BASE / "images"
    out_live_dir = THUMBS_BASE / "live"
    out_img_dir.mkdir(parents=True, exist_ok=True)
    out_live_dir.mkdir(parents=True, exist_ok=True)

    tasks = []
    with ThreadPoolExecutor(max_workers=4) as pool:
        if img_dir.is_dir():
            for f in img_dir.iterdir():
                if f.is_file() and f.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp"}:
                    out = out_img_dir / f"{f.name}.jpg"
                    tasks.append(pool.submit(process_image, f, out))
        if live_dir.is_dir():
            for f in live_dir.iterdir():
                if f.is_file() and f.suffix.lower() in {".mp4", ".webm", ".mkv", ".gif"}:
                    out = out_live_dir / f"{f.name}.jpg"
                    tasks.append(pool.submit(process_video, f, out))
        for t in tasks:
            t.result()

    # Clean orphans
    if img_dir.is_dir():
        for t in out_img_dir.glob("*.jpg"):
            orig_name = t.name[:-4]
            if not (img_dir / orig_name).exists():
                t.unlink(missing_ok=True)
    if live_dir.is_dir():
        for t in out_live_dir.glob("*.jpg"):
            orig_name = t.name[:-4]
            if not (live_dir / orig_name).exists():
                t.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
