{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": null,
    "display": {
        "separator": " - "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "separator",
            "string": "───────────────────────────────────"
        },
        {
            "type": "os",
            "key": "",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "",
            "keyColor": "yellow"
        },
        {
            "type": "uptime",
            "key": "󱑂",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "󰏗",
            "keyColor": "cyan"
        },
        {
            "type": "memory",
            "key": "",
            "keyColor": "magenta"
        },
        {
            "type": "command",
            "key": "",
            "keyColor": "blue",
            "text": "echo $SHELL | xargs basename"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}
